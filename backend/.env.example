# NutriLens Backend Environment Variables

# Application Settings
PROJECT_NAME="NutriLens API"
VERSION="0.1.0"
DEBUG=True
API_V1_PREFIX="/api/v1"

# CORS Settings (Comma-separated origins or * for open development)
ALLOWED_ORIGINS="http://localhost:8081,http://127.0.0.1:8081,*"

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nutrilens_db
# Alternatively provide direct DATABASE_URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrilens_db

# Future API integrations (Not used in Step 1)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPEN_FOOD_FACTS_USER_AGENT=NutriLensApp - Version 0.1.0

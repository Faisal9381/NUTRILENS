# NutriLens Mobile Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# API Backend URL
# ─────────────────────────────────────────────────────────────────────────────
# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# For physical phone on local Wi-Fi:
EXPO_PUBLIC_API_URL=http://192.168.1.9:8000

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth Client IDs (Google Cloud Console → Credentials)
# ─────────────────────────────────────────────────────────────────────────────
# 1. Web Application Client ID (Server Client ID for token generation & backend verification):
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# 2. (Optional) Android Client ID (Package: com.nutrilens.app):
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
